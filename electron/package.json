{
  "name": "gayathri-traders-billing",
  "productName": "Gayathri Traders Billing",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.gayathritraders.billing",
    "productName": "Gayathri Traders Billing",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "dist/**/*",
          "node_modules/**/*",
          "package.json",
          "prisma/**/*"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}
